rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isMember(householdId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/households/$(householdId)/members/$(request.auth.uid));
    }
    function isAdmin(householdId) {
      return isMember(householdId)
        && firestore.get(/databases/(default)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role in ['OWNER', 'ADMIN'];
    }
    match /kids/{householdId}/cards/{assetId} {
      allow read: if isMember(householdId);
      allow create, update: if isAdmin(householdId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.metadata.householdId == householdId
        && request.resource.metadata.ownerUid == request.auth.uid;
      allow delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
